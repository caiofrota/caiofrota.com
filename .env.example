# Only used to expose the Docker Postgres port during local development
# It is not required in production; the application uses DATABASE_URL.
POSTGRES_PORT="55434"

# Database
DATABASE_URL="postgresql://caiofrota:caiofrota@localhost:55434/caiofrota"

# Admin session
SESSION_SECRET="replace-with-a-long-random-secret"
SESSION_MAX_AGE_DAYS="30"

# Login security
LOGIN_RATE_LIMIT_MAX="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"

# Media storage (optional)
# Uploads use the bucket when every R2 variable is configured.
# Without the complete configuration, files are stored automatically in .data/uploads.
# R2_PUBLIC_BASE_URL accepts a full URL or a hostname; hostnames use HTTPS automatically.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Contact form email
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_MAIL_TO=""
