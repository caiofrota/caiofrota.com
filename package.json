{
  "name": "caiofrota.com",
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:caiofrota/caiofrota.com.git",
  "author": "Caio Frota <caiofrota@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "seo": "python3 seo-audit.py https://www.caiofrota.com/ --max-pages 25",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up --wait postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:create": "node --env-file=.env --import tsx scripts/create-admin-user.ts",
    "content:import-legacy": "node --env-file=.env --import tsx scripts/import-legacy-post.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.583.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^5.14.0",
    "@react-pdf/renderer": "^4.3.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@tanstack/react-query": "^5.90.7",
    "@tiptap/extension-image": "^2.4.0",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.552.0",
    "moment": "^2.30.1",
    "next": "^16.0.7",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.10",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^19.2.0",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "sanitize-html": "^2.13.0",
    "tailwindcss": "^4.1.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.6.2",
    "prisma": "^5.14.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.9.3"
  }
}
